PORT=3780

# URL pública usada por los callbacks OAuth. Déjala así si ejecutas la app en local.
APP_BASE_URL=http://localhost:3780

# Identificador eIDAS del TPP, p. ej. PSDES-BDE-XXXXXXX
BBVA_CLIENT_ID=

# sandbox | production
BBVA_ENV=sandbox

# Certificado de cliente QWAC y clave privada (PEM). El HUB de Redsys los exige.
BBVA_CERT_PATH=
BBVA_KEY_PATH=

# Solo para el sandbox si el certificado del servidor no está en el almacén del sistema.
BBVA_TLS_INSECURE=false
